# TLS front end - OPTIONAL.
#
# To enable:
#   1. Obtain a certificate first (see the certbot section of docker-compose.yml).
#   2. cp nginx/tls.conf.example nginx/conf.d/tls.conf
#   3. Replace every REPLACE_WITH_YOUR_DOMAIN below with your real domain.
#   4. Set PUBLIC_URL=https://your-domain in .env, and use_https = true in config.cfg.
#   5. docker compose up -d && docker compose restart nginx
#
# Do NOT copy this file into conf.d before the certificate exists: nginx refuses
# to start when ssl_certificate points at a missing file, which would take the
# whole site down.

server {
    listen 443 ssl;
    http2 on;
    server_name REPLACE_WITH_YOUR_DOMAIN;

    client_max_body_size 10M;

    ssl_certificate     /etc/letsencrypt/live/REPLACE_WITH_YOUR_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/REPLACE_WITH_YOUR_DOMAIN/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    location /assets/ {
        alias /srv/assets/;
        expires 14d;
        add_header Cache-Control "public, no-transform";
        access_log off;
    }

    location /templates/styles/ {
        alias /srv/styles/;
        expires 1d;
        add_header Cache-Control "public, no-transform";
        access_log off;
    }

    location / {
        proxy_pass http://privaterama;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
    }
}

# Redirect plain HTTP for this domain to HTTPS.
# The ACME challenge is intentionally handled BEFORE the redirect so that
# `certbot renew` keeps working after TLS is switched on.
server {
    listen 80;
    server_name REPLACE_WITH_YOUR_DOMAIN;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        access_log off;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
