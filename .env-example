# Copy to .env and edit. Every value below has a working default in
# docker-compose.yml, so `docker compose up -d --build` works even with no .env.
# You only need this file to change credentials or for production

# ─── Docker Compose deployment ───────────────────────────────────────────────
# Postgres credentials. Compose feeds these to BOTH the database container and
# the app's connection string, so you only ever set them in one place.
POSTGRES_USER=skyrama
POSTGRES_PASSWORD=skyrama
POSTGRES_DB=skyrama

# Your domain. This one line is all it takes to go live - Caddy sorts out the
# HTTPS certificate and the game gets pointed at https://<your domain>.
# Leave it unset and everything runs locally on plain http://localhost.
#DOMAIN=skyrama.example.com

# Signs the session cookie. CHANGE THIS before exposing the server: with a known
# value anyone can forge a logged-in session for any account.
SESSION_SECRET=change-me-to-a-long-random-string

# Host ports Caddy binds to. Change if 80/443 are already taken.
#HTTP_PORT=80
#HTTPS_PORT=443

# Host port the containerised database is published on, for psql/pgAdmin/DBeaver.
# Defaults to 5433 because a natively installed PostgreSQL normally holds 5432.

#DB_PORT=5433

# Interface the database port binds to. Leave at 127.0.0.1 (host-only) and use
# an SSH tunnel for remote access:
#   ssh -L 5433:127.0.0.1:5433 user@your-server
# DB_BIND=0.0.0.0 exposes Postgres to the internet, and Docker's iptables rules
# sit in front of ufw so a firewall rule will NOT block it. See docker-compose.yml.

#DB_BIND=127.0.0.1

# ────────────────────── Advanced, you almost certainly don't need these ──────────────────────

# The address the game itself calls. You do NOT normally set this - it is worked
# out from DOMAIN above (or http://localhost when DOMAIN is unset).
# The only real reason to set it: running on a bare LAN IP with no domain, where
# there is no certificate so it has to stay http://.
# Setting it wrong breaks the game while the website still looks fine, so leave
# it alone unless you know you need it.
#PUBLIC_URL=http://192.168.1.50

# ────────────────────── Using your own database instead of the bundled one ──────────────────────
# Pick the line that matches how you run the server. Don't set both.

# Running with Docker:
#DB_URL=postgresql+psycopg://user:password@some-host:5432/skyrama

# Running without Docker (python server.py):
#DB_CONNECTION_STRING=postgresql+psycopg://skyrama:skyrama@localhost:5432/skyrama

# Two names on purpose. Docker reads this file, so a DB_CONNECTION_STRING
# pointing at localhost would follow the app into the container, where
# localhost means the container itself and there is no database.
