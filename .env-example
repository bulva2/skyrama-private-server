# Copy to .env and edit. Every value below has a working default in
# docker-compose.yml, so `docker compose up -d --build` works even with no .env.
# You only need this file to change credentials or go public.

# ─── Docker Compose deployment ───────────────────────────────────────────────
# Postgres credentials. Compose feeds these to BOTH the database container and
# the app's connection string, so you only ever set them in one place.
POSTGRES_USER=skyrama
POSTGRES_PASSWORD=skyrama
POSTGRES_DB=skyrama

# The absolute origin players' browsers use. The Flash client builds its API URL
# from this (PUBLIC_URL + /SkyApi.php), so it must match how you actually reach
# the server - not the internal container port.
#   local testing via nginx : http://localhost
#   LAN                     : http://192.168.1.50
#   public domain with TLS   : https://skyrama.example.com
PUBLIC_URL=http://localhost

# Signs the session cookie. CHANGE THIS before exposing the server: with a known
# value anyone can forge a logged-in session for any account.
SESSION_SECRET=change-me-to-a-long-random-string

# Host ports nginx binds to. Change if 80/443 are already taken.
#HTTP_PORT=80
#HTTPS_PORT=443

# Host port the containerised database is published on, for psql/pgAdmin/DBeaver.
# Defaults to 5433 because a natively installed PostgreSQL normally holds 5432.
#DB_PORT=5433

# Interface the database port binds to. Leave at 127.0.0.1 (host-only) and use
# an SSH tunnel for remote access:
#   ssh -L 5433:127.0.0.1:5433 user@your-server
# DB_BIND=0.0.0.0 exposes Postgres to the internet, and Docker's iptables rules
# sit in front of ufw so a firewall rule will NOT block it. See docker-compose.yml.
#DB_BIND=127.0.0.1

# Keep at 1. Per-user request locks, the world-map player list and the profile
# caches all live in process memory and are not shared between workers, so >1
# worker causes lost updates on player saves.
#WEB_CONCURRENCY=1

# ─── Optional: TLS via Let's Encrypt ─────────────────────────────────────────
# Required only for `docker compose --profile tls run --rm certbot`.
#DOMAIN=skyrama.example.com
#CERTBOT_EMAIL=you@example.com

# ─── Optional: external / non-Docker database ────────────────────────────────
# Overrides the generated connection string. Use this when running Postgres
# yourself instead of the bundled `db` service.
#DB_URL=postgresql+psycopg://user:password@some-host:5432/skyrama

# ─── Running WITHOUT Docker (python server.py) ───────────────────────────────
# In that case the app reads DB_CONNECTION_STRING directly from this file.
# Note "localhost" only works outside Docker; inside a container use "db".
#DB_CONNECTION_STRING=postgresql+psycopg://skyrama:skyrama@localhost:5432/skyrama
